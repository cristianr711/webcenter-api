{
  "version": 2,
  "buildCommand": "echo 'no build needed'",
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": { "maxLambdaSize": "50mb" }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.js"
    },
    {
      "src": "/(.*)",
      "status": 404
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
